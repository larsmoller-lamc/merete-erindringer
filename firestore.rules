rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Kun disse konti (verificeret Google-mail) må røre data.
    // Hold listen identisk med window.ACCESS_LIST i assets/js/firebase-config.js
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'meretevagn@gmail.com',
          'larsmollerchristensen@gmail.com',
          'mettelemmingchristensen@gmail.com',
          'williamlemming07@gmail.com',
          'frederiklemming@gmail.com',
          'carllemming13@gmail.com'
        ];
    }

    // Ét bogmærke pr. bruger pr. side. Dokument-id = <uid>__<bog>__<side>.
    match /bookmarks/{id} {
      allow read:   if allowed() && id.split('__')[0] == request.auth.uid;
      allow delete: if allowed() && id.split('__')[0] == request.auth.uid;
      allow create, update: if allowed()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.book is string
        && request.resource.data.page is string
        && id == request.auth.uid + '__' + request.resource.data.book + '__' + request.resource.data.page;
    }

    // Alt andet er lukket.
    match /{document=**} { allow read, write: if false; }
  }
}
